---
// An illustrative transit light curve, drawn here at build time so the page needs no
// JavaScript. The seeded noise and the model are the same as in the approved mock-up.
//
// The SVG stretches to the width of the page (preserveAspectRatio="none"). Strokes use
// vector-effect: non-scaling-stroke (see global.css), so the line keeps its width and each
// data point, a zero-length stroke with round caps, stays a round dot at any width.

const DEPTH = 0.0062;
const T_HALF = 1.25; // hours from mid-transit to first and fourth contact
const T_FLAT = 0.95; // hours from mid-transit to second and third contact

function model(t: number): number {
  const a = Math.abs(t);
  if (a >= T_HALF) return 1;
  // Limb darkening: the dip is deepest at mid-transit.
  const depth = (x: number) =>
    DEPTH * (1 - 0.28 * (1 - Math.sqrt(Math.max(0, 1 - (x / T_HALF) ** 2))));
  if (a <= T_FLAT) return 1 - depth(a);
  return 1 - (depth(T_FLAT) * (T_HALF - a)) / (T_HALF - T_FLAT);
}

// Mulberry32, so the noise is the same on every build.
function rng(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1000;
const H = 92;
const PAD_X = 2;
const PAD_Y = 6;
const [T_MIN, T_MAX] = [-4, 4];
const [F_MIN, F_MAX] = [0.9905, 1.0035];

const x = (t: number) => (PAD_X + ((t - T_MIN) / (T_MAX - T_MIN)) * (W - 2 * PAD_X)).toFixed(1);
const y = (f: number) => (PAD_Y + ((F_MAX - f) / (F_MAX - F_MIN)) * (H - 2 * PAD_Y)).toFixed(2);

const random = rng(20261015);
let points = '';
for (let i = 0; i < 380; i++) {
  const t = T_MIN + ((T_MAX - T_MIN) * i) / 379;
  // Box–Muller: a normally distributed noise value from two uniform ones.
  const g = Math.sqrt(-2 * Math.log(random() + 1e-12)) * Math.cos(2 * Math.PI * random());
  points += `M${x(t)} ${y(model(t) + 0.00105 * g)}h0`;
}

// Flat outside the transit, straight through ingress and egress, curved in between.
const curve: number[] = [T_MIN, -T_HALF];
for (let i = 0; i <= 60; i++) curve.push(-T_FLAT + (2 * T_FLAT * i) / 60);
curve.push(T_HALF, T_MAX);
const modelPath = curve.map((t, i) => `${i ? 'L' : 'M'}${x(t)} ${y(model(t))}`).join('');

const label =
  "An illustrative transit light curve: a star's brightness dips briefly as a planet passes in front of it";
---

<svg class="lc" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={label}>
  <path class="lc-points" d={points}></path>
  <path class="lc-model" d={modelPath}></path>
</svg>
