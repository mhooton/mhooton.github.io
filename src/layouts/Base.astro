---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteName } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Link-preview image (1200×630) under public/og/. */
  ogImage?: string;
  ogImageAlt?: string;
  footer?: 'default' | 'mentorship';
  /** False for pages search engines should skip, such as the 404 page. */
  index?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.jpg',
  ogImageAlt = 'Matthew Hooton',
  footer = 'default',
  index = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0c1422" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-display" preload={[{ weight: '600', style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <SiteHeader />
    </div>
    <main id="main">
      <slot />
    </main>
    <div class="wrap">
      <SiteFooter variant={footer} />
    </div>
  </body>
</html>
