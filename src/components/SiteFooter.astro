---
import { emailText, profiles } from '../data/site';

interface Props {
  variant?: 'default' | 'mentorship';
}

const { variant = 'default' } = Astro.props;
---

{
  variant === 'mentorship' ? (
    <footer class="site-footer mentor-footer">
      <span class="indep">Exoplanet Research Mentorship is offered privately by Dr Matthew Hooton.</span>
      <span>
        <a href="/">Home</a> · <a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a>
      </span>
      <span class="photo-credit">Photographs by Matthew Hooton unless credited otherwise.</span>
    </footer>
  ) : (
    <footer class="site-footer">
      <span>Matthew Hooton · {emailText}</span>
      <span>
        <a href="/mentorship/">Mentorship</a> · <a href={profiles.ads}>ADS</a> · <a href={profiles.orcid}>ORCID</a> · <a href={profiles.github}>GitHub</a> · <a href="/privacy/">Privacy</a>
      </span>
      <span class="photo-credit">Photographs by Matthew Hooton unless credited otherwise.</span>
    </footer>
  )
}
