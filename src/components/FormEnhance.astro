---
// Shared by both forms; Astro includes the script once per page.
---

<script>
  // Progressive enhancement for the Formspree forms: send the form with fetch and confirm
  // on the page. Without JavaScript the form posts normally and Formspree shows its own
  // confirmation page. If the fetch fails for any reason, the form falls back to that POST.

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-enhance]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (button) button.disabled = true;
      if (status) {
        status.textContent = 'Sending…';
        delete status.dataset.state;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formspree returned ${response.status}`);
        form.reset();
        if (status) {
          status.textContent = form.dataset.thanks ?? 'Thank you. Your message has been sent.';
          status.dataset.state = 'done';
        }
      } catch {
        if (status) status.textContent = '';
        // form.submit() skips this handler, so the browser posts the form normally.
        form.submit();
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
